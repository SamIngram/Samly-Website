---
import BaseLayout from '../layouts/BaseLayout.astro';
import DecorativeArtwork from '../components/DecorativeArtwork.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { links } from '../data/links';
---

<BaseLayout title="About — Samly" description="Meet Sam, the Leeds-based indie game developer, lo-fi musician, cosy streamer and community host behind Samly.">
	<section class="page-hero">
		<div class="container about-intro">
			<DecorativeArtwork type="profile" label="Pixel-art portrait of Sam smiling" />
			<div>
				<p class="eyebrow">Leeds, UK</p>
				<h1>Hello, I’m Sam</h1>
				<p>I’m the person behind Samly: an indie game developer, lo-fi musician, cosy streamer and community host. This is the shared home for those different parts of my creative work.</p>
				<a class="text-link" href={links.personal}>Visit my personal website <span aria-hidden="true">↗</span></a>
			</div>
		</div>
	</section>
	<section class="section">
		<div class="container">
			<div class="feature-grid about-features">
				<FeatureCard icon="♧" title="Game development" text="Small indie games made with curiosity, care and room to breathe." href="/games" accent="olive" />
				<FeatureCard icon="♫" title="Lo-fi music" text="Ambient and indie sounds for creative and quiet moments." href="/music" accent="plum" />
				<FeatureCard icon="◉" title="Cosy streaming" text="Creative projects, games and calm company on Twitch." href="/streams" accent="coral" />
				<FeatureCard icon="♥" title="Community hosting" text="A welcoming online space built around kindness and no pressure." href="/famly" accent="orange" />
			</div>
		</div>
	</section>
	<section class="section">
		<div class="container narrow">
			<div class="health-card">
				<span aria-hidden="true">🌿</span>
				<div><p class="eyebrow">Health and neurodivergence</p><h2>A little more context</h2><p>I’ve written about my long-term health conditions, ADHD and autism, and how they affect everyday life.</p></div>
				<a class="button button-quiet" href="/health">Read about my health <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>
</BaseLayout>
