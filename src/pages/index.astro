---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GameCard from '../components/GameCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import DecorativeArtwork from '../components/DecorativeArtwork.astro';
import SupportPanel from '../components/SupportPanel.astro';
import { games } from '../data/games';
import { links } from '../data/links';
---

<BaseLayout>
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">Hello, I’m Sam <span aria-hidden="true">✦</span></p>
				<h1>Welcome to my <em>cosy corner</em> of the internet.</h1>
				<p class="hero-lede">I make cosy games, create music, stream relaxing games and build kind communities.</p>
				<div class="button-row hero-actions">
					<a class="button button-primary" href={links.twitch}>Watch on Twitch <span aria-hidden="true">↗</span></a>
					<a class="button button-secondary" href="/games">Explore my games <span aria-hidden="true">→</span></a>
				</div>
				<p class="soft-note"><span aria-hidden="true">●</span> Creative company, at a gentle pace.</p>
			</div>
			<div class="hero-art-wrap">
				<DecorativeArtwork type="hero" label="Sam smiling at his laptop in a cosy home studio beside a mug and sleeping cream tabby cat" />
				<span class="hero-sticker sticker-one" aria-hidden="true">cosy<br />games</span>
				<span class="hero-sticker sticker-two" aria-hidden="true">lo-fi<br />sounds</span>
			</div>
		</div>
	</section>

	<section class="section games-preview">
		<div class="container">
			<div class="section-topline">
				<SectionHeading eyebrow="Games by Samly" title="Small worlds, made with care" text="Cosy experiments and gentle adventures for Steam and Itch." />
				<a class="text-link desktop-link" href="/games">See all games <span aria-hidden="true">→</span></a>
			</div>
			<div class="game-grid">{games.slice(0, 3).map((game) => <GameCard game={game} />)}</div>
			<a class="text-link mobile-section-link" href="/games">See all games <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section class="section what-i-make">
		<div class="container">
			<SectionHeading eyebrow="A bit of everything" title="What I make" text="Pick a corner and make yourself comfortable." align="center" />
			<div class="feature-grid">
				<FeatureCard icon="◉" title="Streams" text="Streaming relaxing games and offering gentle company over on Twitch." href="/streams" accent="coral" />
				<FeatureCard icon="♧" title="Games" text="Small, thoughtful games built for slow afternoons and curious minds." href="/games" accent="olive" />
				<FeatureCard icon="♥" title="Famly" text="A kind community for making things, sharing things or simply being around." href="/famly" accent="orange" />
				<FeatureCard icon="♫" title="Music" text="Lo-fi and ambient sounds for working, resting and wandering." href="/music" accent="plum" />
			</div>
		</div>
	</section>

	<section class="section split-section music-home">
		<div class="container split-grid">
			<DecorativeArtwork type="music" label="A cosy pink home music studio with a keyboard, yellow-coned speakers and headphones" />
			<div>
				<p class="eyebrow">Music for quiet moments</p>
				<h2>Soft sounds for wherever you are</h2>
				<p>I make lo-fi and ambient music for slow mornings, creative afternoons and late-night thinking.</p>
				<div class="platform-links" aria-label="Listen to Samly">
					<a href={links.spotify}>Spotify <span aria-hidden="true">↗</span></a>
					<a href={links.appleMusic}>Apple Music <span aria-hidden="true">↗</span></a>
					<a href={links.soundcloud}>SoundCloud <span aria-hidden="true">↗</span></a>
					<a href={links.youtubeMusic}>YouTube <span aria-hidden="true">↗</span></a>
					<a href={links.bandcamp}>Bandcamp <span aria-hidden="true">↗</span></a>
				</div>
				<a class="text-link" href="/music">More about the music <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section class="section split-section famly-home">
		<div class="container split-grid split-reverse">
			<div>
				<p class="eyebrow">The Famly</p>
				<h2>Kind company, no pressure</h2>
				<p>The Famly is a calm and supportive community for creativity, cosy company and turning up exactly as you are. Join in, lurk quietly or take a break whenever you need.</p>
				<div class="button-row">
					<a class="button button-primary" href={links.discord}>Join the Discord <span aria-hidden="true">↗</span></a>
					<a class="button button-quiet" href="/famly">Meet the Famly <span aria-hidden="true">→</span></a>
				</div>
			</div>
			<DecorativeArtwork type="community" label="Four friends relaxing together in a cosy pink lounge with mugs, sketchbooks, crafts and plants" />
		</div>
	</section>

	<section class="section about-home">
		<div class="container about-card">
			<DecorativeArtwork type="profile" label="Pixel-art portrait of Sam smiling" />
			<div>
				<p class="eyebrow">About Sam</p>
				<h2>Hello from Leeds</h2>
				<p>I’m Sam, an indie game developer, lo-fi musician, cosy streamer and community host based in Leeds, UK. Samly is where those different creative bits all live together.</p>
				<div class="inline-links">
					<a class="text-link" href="/about">More about me <span aria-hidden="true">→</span></a>
					<a class="text-link muted-link" href={links.personal}>Visit samingram.co.uk <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</div>
	</section>

	<section class="section support-home">
		<div class="container"><SupportPanel /></div>
	</section>
</BaseLayout>
