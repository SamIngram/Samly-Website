---
interface Props {
	icon: string;
	title: string;
	text: string;
	href?: string;
	label?: string;
}
const { icon, title, text, href, label = 'Coming soon' } = Astro.props;
---

<article class="resource-card">
	<span class="resource-icon" aria-hidden="true">{icon}</span>
	<div>
		<h3>{title}</h3>
		<p>{text}</p>
		{href ? <a class="text-link" href={href}>{label} <span aria-hidden="true">→</span></a> : <span class="coming-soon">{label}</span>}
	</div>
</article>
